<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <template id="planilla_iasper_template">
            <t t-call="web.external_layout">
                <t t-set="png_background" t-value="'/ing_seguros/static/src/pdf/Formulario-de-Denuncia.png'"/>
                <div class="page">
                    <div class="container" style="position: absolute; top: 0; left: 0; width: 100%;">
                        <t t-foreach="docs" t-as="o">
                            <style>
                                .field-overlay { position: absolute; font-size: 12px; }
                            </style>

                            <!-- Datos del Siniestro -->
                            <span class="field-overlay" style="top: 120px; left: 250px;"><t t-esc="o.poliza_numero"/></span>
                            <span class="field-overlay" style="top: 120px; left: 450px;"><t t-esc="o.siniestro_numero"/></span>
                            <span class="field-overlay" style="top: 140px; left: 250px;"><t t-esc="o.querrellante_nombre"/></span>
                            <span class="field-overlay" style="top: 160px; left: 250px;"><t t-esc="o.telefono_querrellante"/></span>
                            <span class="field-overlay" style="top: 180px; left: 250px;"><t t-esc="o.lugar_fecha"/></span>

                            <!-- Datos del Asegurado -->
                            <span class="field-overlay" style="top: 220px; left: 250px;"><t t-esc="o.employee_id.name"/></span>
                            <span class="field-overlay" style="top: 240px; left: 250px;"><t t-esc="o.asegurado_dni"/></span>
                            <span class="field-overlay" style="top: 260px; left: 250px;"><t t-esc="o.asegurado_calle"/></span>
                            <span class="field-overlay" style="top: 280px; left: 250px;"><t t-esc="o.asegurado_provincia"/></span>
                            <span class="field-overlay" style="top: 300px; left: 250px;"><t t-esc="o.asegurado_cp"/></span>
                            <span class="field-overlay" style="top: 320px; left: 250px;"><t t-esc="o.asegurado_localidad"/></span>
                            <span class="field-overlay" style="top: 340px; left: 250px;"><t t-esc="o.tarea_efectuada"/></span>
                            <span class="field-overlay" style="top: 360px; left: 250px;"><t t-esc="o.asegurado_edad"/></span>

                            <!-- Datos del Accidente -->
                            <span class="field-overlay" style="top: 400px; left: 250px;"><t t-esc="o.dia"/></span>
                            <span class="field-overlay" style="top: 420px; left: 250px;"><t t-esc="o.mes"/></span>
                            <span class="field-overlay" style="top: 440px; left: 250px;"><t t-esc="o.anio"/></span>
                            <span class="field-overlay" style="top: 460px; left: 250px;"><t t-esc="o.hora"/></span>
                            <span class="field-overlay" style="top: 480px; left: 250px;"><t t-esc="o.lugar_accidente"/></span>
                            <span class="field-overlay" style="top: 500px; left: 250px;"><t t-esc="o.circunstancias"/></span>

                            <!-- Datos del Denunciante -->
                            <span class="field-overlay" style="top: 540px; left: 250px;"><t t-esc="o.tipo_denunciante"/></span>
                            <span class="field-overlay" style="top: 560px; left: 250px;"><t t-esc="o.denunciante_nombre"/></span>
                            <span class="field-overlay" style="top: 580px; left: 250px;"><t t-esc="o.denunciante_domicilio"/></span>

                        </t>
                    </div>
                </div>
            </t>
        </template>

        <report
            id="inf_planilla_iasper_report"
            model="ing.seguros.planilla.iasper"
            string="Informe Planilla IASPER"
            report_type="qweb-html"
            name="ing_seguros.planilla_iasper_template"
            file="ing_seguros.planilla_iasper_template"
            menu="False"/>

    </data>
</odoo>
